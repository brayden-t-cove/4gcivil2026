generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A record of a completed 1-year trial camera install, just enough for
// Bossman to transfer the dealer account from the Luna database to the
// Alder database. Detailed install/troubleshooting steps live on the
// separate install tech ticket the tech already fills out.
model TrialInstall {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  techName            String // tech name or employee ID
  pandoAccountNumber  String
  customerLunaEmail   String // customer's account email on Luna
  setupSuccessful     Boolean @default(false)

  needsPublishing Boolean   @default(false) // flagged by tech: account still needs to be published
  publishedAt     DateTime? // set when someone works this off the publish queue

  notes String?
}

// DOA / failure / troubleshooting ticket (SOP section 8), also used for
// coverage failures found during site test before any customer install.
model FailureTicket {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  techName String

  category String
  // "doa_wont_come_online" | "coverage_failure" | "connectivity_registration"
  // | "wrong_card_used" | "event_detection_failure" | "mounting_hardware" | "other"

  customerName String? // blank if this happened during site test, pre-customer

  originalCameraSerial    String?
  replacementCameraSerial String?

  symptoms        String
  troubleshootingSteps String?
  resolvedOnSite  Boolean @default(false)

  notes String?
}
